# soccer-mcp environment — copy to deploy/soccer-mcp.env on the host (never commit it: this repo
# is public, and the file holds the live sentiment token). The systemd unit reads it via
# EnvironmentFile=/root/soccer-mcp/deploy/soccer-mcp.env (deploy/install-mcp-service.sh shows the
# alternative of baking Environment= lines straight into the unit).
SOCCER_MCP_HTTP=1
SOCCER_MCP_HTTP_HOST=127.0.0.1
SOCCER_MCP_HTTP_PORT=8790
# Comma-separated plugins attached to the server at startup. The public tier ships only the
# sentiment plugin; an operator appends their own (kept out of this repo), e.g.
#   SOCCER_MCP_PLUGINS=soccer_mcp.plugins_sentiment,/opt/private/soccer-mcp-tools.py
SOCCER_MCP_PLUGINS=soccer_mcp.plugins_sentiment
# Team-sentiment backend (dashboard). The token is the dashboard's bearer fast-path
# (config/token on the operator's host) — the real value belongs ONLY in the untracked env file.
SOCCER_SENTIMENT_URL=https://your-dashboard-host/soccer
SOCCER_SENTIMENT_TOKEN=replace-me
