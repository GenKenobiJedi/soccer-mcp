{
    "actorRunView": {
        "title": "Run overview",
        "columns": [
            {"title": "Field", "chartOn": false, "format": "[data.name]"},
            {"title": "Value", "chartOn": false, "format": "[data.value]"}
        ],
        "transform": null
    },
    "datasetView": {
        "title": "Tool result",
        "columns": [
            {"raw": {"field": "tool", "label": "Tool", "format": "\n${item.tool}\n"}},
            {"raw": {"field": "ok", "label": "OK", "format": "\n${item.ok}\n"}},
            {"raw": {"field": "arguments", "label": "Arguments", "format": "\n${JSON.stringify(item.arguments)}\n"}},
            {"raw": {"field": "data", "label": "Data", "format": "\n${item.data}\n"}},
            {"raw": {"field": "duration_ms", "label": "Duration (ms)", "format": "\n${item.duration_ms}\n"}},
            {"raw": {"field": "generated_at", "label": "Generated at", "format": "\n${item.generated_at}\n"}}
        ],
        "transform": null
    },
    "keyValueStoreView": null
}
